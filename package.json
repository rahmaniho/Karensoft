{
  "name": "karen-soft",
  "version": "3.0.0",
  "private": true,
  "description": "وب‌سایت رسمی کارن سافت — Next.js (Static Export) برای GitHub Pages",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "npx serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib scripts --ext .js,.mjs,.ts,.tsx",
    "lint:fix": "eslint app components lib scripts --ext .js,.mjs,.ts,.tsx --fix",
    "validate": "npm run typecheck && npm run lint",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "howler": "^2.2.4",
    "lenis": "~1.3.11",
    "lucide-react": "~0.544.0",
    "next": "~15.5.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "~3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "~4.1.13",
    "@types/howler": "^2.2.13",
    "@types/node": "~22.10.0",
    "@types/react": "~19.1.13",
    "@types/react-dom": "~19.1.9",
    "eslint": "~8.57.1",
    "eslint-config-next": "~15.5.9",
    "sharp": "^0.35.5",
    "tailwindcss": "~4.1.13",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
