# --- فرم‌های وب‌سایت (فقط یکی را تنظیم کنید) ---
# انتخاب ساده برای خروجی استاتیک: شناسه را از داشبورد Formspree بگیرید.
NEXT_PUBLIC_FORMSPREE_ID=

# یا URL عمومی API سروری که خودتان میزبانی می‌کنید (نمونهٔ Resend در examples/resend-contact).
# کلید Resend هرگز در متغیر NEXT_PUBLIC_* قرار نگیرد.
NEXT_PUBLIC_CONTACT_API_URL=

# شناسهٔ عمومی Crisp. اگر خالی باشد، شناسهٔ استخراج‌شده از taxi-app استفاده می‌شود.
NEXT_PUBLIC_CRISP_WEBSITE_ID=
