# Formspree Configuration
# Get your form ID from https://formspree.io
# Steps:
# 1. Sign up/login to formspree.io
# 2. Create a new form
# 3. Copy the form ID (e.g., xyzabcde)
# 4. Paste it below
NEXT_PUBLIC_FORMSPREE_ID=YOUR_FORM_ID_HERE

# Optional: Analytics (if you want to add later)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
